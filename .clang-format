Language: Cpp

# Based on Google style
BasedOnStyle: Google

# Use the latest supported standard
Standard: Latest

# No line length limit
ColumnLimit: 0

# Indent by 4 spaces
IndentWidth: 4

# Opening braces attached to the name
BreakBeforeBraces: Attach

# No space before parentheses for function calls; space before parentheses for control statements
SpaceBeforeParens: ControlStatements

# Function return type on the same line as the function name
AlwaysBreakAfterDefinitionReturnType: None
AlwaysBreakAfterReturnType: None

# Pointer symbol attached to the type
PointerAlignment: Left

# Do not derive pointer/reference alignment from existing code (prevents unwanted spaces between type and *)
DerivePointerAlignment: false

# Access modifiers aligned to the left
AccessModifierOffset: -4

# Indent case and default labels
IndentCaseLabels: true

# No spaces inside braced lists (C++11 style)
Cpp11BracedListStyle: true

# Align variable names in consecutive declarations
AlignConsecutiveDeclarations: true

# Align assignment operators in consecutive assignments
AlignConsecutiveAssignments: true

UseTab: Never
TabWidth: 4

# Allow if statements on a single line
AllowShortIfStatementsOnASingleLine: true

# Indentation within namespaces
#NamespaceIndentation: All
NamespaceIndentation: None
